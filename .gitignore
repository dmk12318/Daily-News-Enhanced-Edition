# Python
__pycache__/
*.py[cod]

# 本地中间产物（可由脚本重建，不进仓库）
data/news.db
shots/

# 每次运行都会重新生成的产物：不进仓库
#   out/  —— 日报 Markdown（云端生成）
#   site/ —— 渲染好的站点（由 Actions 直接作为 Pages 产物上传，不需要进仓库）
out/
site/

# 每次运行都会重写的诊断/中间文件：云端和本地都会写，进仓库会互相覆盖
data/fetch_report.json
data/html_fallback_report.json
data/browser_fallback_report.json
data/gnews_report.json
data/to_classify.json
data/sections.json

